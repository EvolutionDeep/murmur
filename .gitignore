# Dependencies
node_modules/

# Secrets — NEVER commit
.dev.vars
.env
.env.local
*.pk
*.key
# Circle API key staging file for the facilitator pre-flight probe — NEVER commit
.circle-key.local

# Local one-off ops scripts (deploy preflight/verify/wipe) + generated registry address
packages/trader-worker/scripts/_*.mjs
packages/trader-worker/contracts/REGISTRY_ADDRESS.txt
packages/trader-worker/contracts/LINEAGE_ADDRESS.txt

# Build output
dist/
build/
.wrangler/
coverage/
.cache/

# Logs
*.log

# OS
.DS_Store
Thumbs.db

# Legacy pre-murmur artifacts (old fly-lineage renders) — excluded so they can never be
# committed; the lineage/breeding system they depict no longer exists. Safe to delete locally.
/family_tree_*.png

# Offline connectome data downloads (FAFB 783 feather files, ~327MB) — never commit
_connectome_data/

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
.qoder/

# Root-level scratch artifacts: one-off probes, deploy/verify logs, response dumps,
# CDP/browser profiles (_shot_prof/, _rv_prof/, _cdp_*/, ...). None of these are tracked
# (`git ls-files | grep '^_'` is empty), so ignoring them cannot change any tracked file.
/_*

# Root scripts/ local one-offs (benchmarks, probes) — never committed
scripts/_*

# Legacy design exploration mockups — kept on disk for reference, never committed
design-mockups/

# TensorFlow Lite model blobs — binary weights never belong in git
*.tflite
