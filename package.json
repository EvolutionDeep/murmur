{
  "name": "murmur",
  "version": "0.2.0",
  "private": true,
  "description": "murmur — a population of fruit-fly nervous systems adrift on the Arc market, each an autonomous agent whose LIF connectome is built from the real FAFB 783 FlyWire MB+CX subgraph (10,361 neurons / 467,314 synapses, CC-BY 4.0, committed on-chain), deciding what to buy and from whom, settling in real USDC on Arc mainnet over x402. Every payment is a verifiable on-chain transaction; no LLM decides anything.",
  "license": "MIT",
  "keywords": [
    "arc",
    "x402",
    "usdc",
    "eip-3009",
    "agent-economy",
    "connectome",
    "spiking-neural-network",
    "cloudflare-workers",
    "durable-objects",
    "d1"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EvolutionDeep/murmur.git"
  },
  "homepage": "https://www.muros.live",
  "bugs": {
    "url": "https://github.com/EvolutionDeep/murmur/issues"
  },
  "workspaces": [
    "packages/fly-brain",
    "packages/trader-worker",
    "packages/frontend",
    "packages/arc-circle-x402"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc --noEmit -p packages/fly-brain/tsconfig.json && tsc --noEmit -p packages/trader-worker/tsconfig.json && tsc --noEmit -p packages/arc-circle-x402/tsconfig.json",
    "test": "npm run test --workspaces --if-present",
    "smoke": "tsx packages/fly-brain/smoke.ts",
    "replay": "npm run replay -w @fly/trader-worker -- --from-wrangler",
    "check:knobs": "node scripts/check-knob-defaults.mjs",
    "verify:poca": "node scripts/poca-verify.mjs",
    "verify:poca:selftest": "node scripts/poca-verify.mjs --selftest",
    "verify:audit": "node scripts/audit-live.mjs",
    "verify:audit:offline": "node scripts/audit-live.mjs --offline",
    "dev:worker": "npm run dev -w @fly/trader-worker",
    "deploy:worker": "node scripts/gen-codecommit.mjs && npm run deploy -w @fly/trader-worker",
    "deploy:frontend": "npm run deploy -w @fly/frontend",
    "deploy": "npm run deploy:worker && npm run deploy:frontend"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "wrangler": "^4.141.0"
  },
  "engines": {
    "node": ">=20"
  },
  "optionalDependencies": {
    "@cloudflare/workerd-windows-64": "^1.20260929.1"
  }
}
