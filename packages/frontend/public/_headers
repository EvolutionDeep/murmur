# Cloudflare Pages cache control
# HTML is never cached, so users always receive the latest entrypoint
/index.html
  Cache-Control: no-store, max-age=0

/
  Cache-Control: no-store, max-age=0

# The developer docs page renders /openapi.json live — keep the HTML uncached too
# (Cloudflare Pages serves developers.html at the clean URL /developers)
/developers
  Cache-Control: no-store, max-age=0

# The community governance page renders live D1 content (feed / proposals / tallies) — keep it uncached
# (Cloudflare Pages serves community.html at the clean URL /community)
/community
  Cache-Control: no-store, max-age=0

# The Arc x402 Canary renders live settlement telemetry (/economy + /history + /proofs) — keep it uncached
# (Cloudflare Pages serves canary.html at the clean URL /canary)
/canary
  Cache-Control: no-store, max-age=0

# JS/CSS force revalidation (paired with the ?v= version query in index.html as belt-and-braces)
/app.js
  Cache-Control: no-cache, must-revalidate

/community.js
  Cache-Control: no-cache, must-revalidate

/styles.css
  Cache-Control: no-cache, must-revalidate

# The split ESM tree is imported bare (no ?v= on the sub-module specifiers, and render2d.js has six
# importers so adding ?v would fork duplicate module instances). Force etag revalidation on the entry
# and the modules touched by the five-nations rebuild so returning readers never run stale bytes.
/main.js
  Cache-Control: no-cache, must-revalidate

/scene3d.js
  Cache-Control: no-cache, must-revalidate

/nations.js
  Cache-Control: no-cache, must-revalidate

/render2d.js
  Cache-Control: no-cache, must-revalidate

/camera.js
  Cache-Control: no-cache, must-revalidate

# task 26 touched these two bare-imported modules (renderChronTicker deleted, pollChron rewired)
# — same etag-revalidation treatment so returning readers never run stale bytes.
/drawers.js
  Cache-Control: no-cache, must-revalidate

/polling.js
  Cache-Control: no-cache, must-revalidate

# task 32 added civstage.js — a new bare-imported module (polling.js → civstage.js, no ?v on the
# specifier), so it needs the same etag-revalidation treatment or returning readers run stale bytes.
/civstage.js
  Cache-Control: no-cache, must-revalidate

# task 38: reform templates added to shared.js + i18n-chron.js translations — force revalidation
/shared.js
  Cache-Control: no-cache, no-store, must-revalidate

/i18n-chron.js
  Cache-Control: no-cache, no-store, must-revalidate

# task 41: the Temple added UI keys to i18n-ui.js and is reached through i18n.js (both bare/?v
# imported by five live modules). Force revalidation on both so returning readers never run a
# cached i18n.js?v=96 that still points at the pre-Temple i18n-ui.js dictionary.
/i18n.js
  Cache-Control: no-cache, no-store, must-revalidate

/i18n-ui.js
  Cache-Control: no-cache, no-store, must-revalidate

# task 48: walk mode module — bare-imported by main.js, needs etag revalidation
/walkMode.js
  Cache-Control: no-cache, must-revalidate

# task 49: the tick-driven day/night cycle — bare-imported by scene3d.js, needs etag revalidation
/dayNight.js
  Cache-Control: no-cache, must-revalidate

/economy.js
  Cache-Control: no-cache, must-revalidate

/inspector.js
  Cache-Control: no-cache, must-revalidate

# task 51: procedural terrain splat textures — bare-imported by scene3d.js
/terrainTex.js
