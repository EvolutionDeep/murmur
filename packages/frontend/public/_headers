# Cloudflare Pages cache control
# HTML is never cached, so users always receive the latest entrypoint
/index.html
  Cache-Control: no-store, max-age=0

/
  Cache-Control: no-store, max-age=0

# The developer docs page renders /openapi.json live — keep the HTML uncached too
# (Cloudflare Pages serves developers.html at the clean URL /developers)
/developers
  Cache-Control: no-store, max-age=0

# The community governance page renders live D1 content (feed / proposals / tallies) — keep it uncached
# (Cloudflare Pages serves community.html at the clean URL /community)
/community
  Cache-Control: no-store, max-age=0

# The Arc x402 Canary renders live settlement telemetry (/economy + /history + /proofs) — keep it uncached
# (Cloudflare Pages serves canary.html at the clean URL /canary)
/canary
  Cache-Control: no-store, max-age=0

# JS/CSS force revalidation (paired with the ?v= version query in index.html as belt-and-braces)
/app.js
  Cache-Control: no-cache, must-revalidate

/community.js
  Cache-Control: no-cache, must-revalidate

/styles.css
  Cache-Control: no-cache, must-revalidate

# ─── ESM module cache policy ───────────────────────────────────────────────────
# All local ESM modules now carry ?v=N on every import specifier (task 75).
# The muros.live custom domain applies a zone-level Cache Rule (max-age=14400) that
# OVERRIDES these _headers for paths without no-store. The ?v= query string ensures
# each deploy produces unique URLs → CDN cache miss → fresh bytes from origin.
# These no-cache entries remain as belt-and-braces for the Pages origin itself.
#
# Bump procedure: run `node scripts/bump-frontend-version.mjs` (auto-increments
# from the current main.js?v= in index.html). ALL local imports are stamped in
# lockstep to the same version, guaranteeing no module-instance forking.
#
# New modules: add a /newMod.js entry here AND the bump script will automatically
# stamp ?v= on any import referencing it (it matches all ./x.js patterns).
/main.js
  Cache-Control: no-cache, must-revalidate

/scene3d.js
  Cache-Control: no-cache, must-revalidate

/nations.js
  Cache-Control: no-cache, must-revalidate

/render2d.js
  Cache-Control: no-cache, must-revalidate

/camera.js
  Cache-Control: no-cache, must-revalidate

