  Cache-Control: no-cache, must-revalidate

# task 33 · gate 5 found this PRE-EXISTING gap while auditing bare-module coverage: sim.js is imported with a
# BARE specifier by camera.js, economy.js, main.js and render2d.js (the task-8 ESM split) but was never given
# the etag-revalidation entry its four siblings all have, so a returning reader can run a stale swarm core
# against fresh neighbours. Purely additive cache metadata — sim.js itself is NOT touched. Drop this block if
# the 3D owner prefers to land it separately.
/sim.js
  Cache-Control: no-cache, must-revalidate

# NSFW filter model weights (self-hosted binary, loaded by landDrawer.js via nsfwjs).
# The 2.6MB shard + 129KB manifest are immutable content — cache aggressively so the
# lazy load on first upload is cheap for returning visitors. Rename the dir to bust.
/assets/nsfw/*
  Cache-Control: public, max-age=31536000, immutable

# task 15: the connectome atlas metadata (a verbatim copy of fly-brain's fafb783-mb-cx-meta.json,
# fetched once when the prove-the-brain drawer's atlas fold is first expanded). It is a bare-path new
# file with no ?v cache-buster, so force etag revalidation (same treatment as /landLayer.js) — a
# returning reader must never run stale atlas bytes after a subgraph re-cut.
/flywire-meta.json
  Cache-Control: no-cache, must-revalidate

# task 51: the PoCA verifier pure core (pocaVerify.js) — a bare-ESM module imported with NO ?v cache-buster
# by both the browser audit console (window.__pocaVerify) and, byte-for-byte, the Node CLI. Force etag
# revalidation so a returning auditor never runs a stale crypto core against fresh chain data.
/pocaVerify.js
  Cache-Control: no-cache, no-store, must-revalidate
